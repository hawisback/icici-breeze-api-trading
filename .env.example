# ==============================================================================
# ICICI Direct Options Trading Platform v2 Configuration Template
# ==============================================================================

# Application Environment & Service Identity
APP_ENV=development                       # development, testing, or production
SERVICE_NAME=trading-platform             # Name of the service/process
DATA_ROOT=./data                          # Root directory for service-owned SQLite DBs

# Event Bus & Streaming Backbone
EVENT_BUS_BACKEND=memory                  # memory (dev/test) or redpanda (production)
REDPANDA_BROKERS=localhost:19092          # Required if EVENT_BUS_BACKEND=redpanda
REDIS_URL=redis://localhost:6379/0        # Optional live cache/locks

# Trading Authority & Release Controls (Fail-Closed)
DEFAULT_TRADING_MODE=PAPER                # Always PAPER (LIVE cannot be default)
LIVE_TRADING_ENABLED=false                # Master server-side gate for live orders
LIVE_ALLOWED_ACCOUNTS=[]                  # JSON array of approved accounts e.g. ["ACC123"]

# API Gateway & Boundary Security
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]  # Strict list of origins; no wildcards
AUTH_SIGNING_KEY=change_me_to_a_secure_random_key_in_production
MAX_REQUEST_BODY_BYTES=1048576             # Maximum request payload size in bytes (1MB)
RATE_LIMIT_ENABLED=true                    # Enable API rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5              # Max login attempts per minute per IP
RATE_LIMIT_ORDERS_PER_MINUTE=30            # Max order/risk commands per minute per client
RATE_LIMIT_GENERAL_PER_MINUTE=120          # Max general queries per minute per client
IDEMPOTENCY_TTL_SECONDS=86400              # Command idempotency cache TTL in seconds (24h)
AUTO_MIGRATE_ON_STARTUP=true               # Run migrations on startup (true in dev/test, false for strict prod)
MIGRATION_BACKUP_DIR=./data/backups        # Directory for pre-migration safety backups

# Market Data Feed
MARKET_DATA_BACKEND=simulated             # simulated (dev/paper) or breeze (legacy market-data switch)
BROKER_BACKEND=breeze                     # breeze or kite; selects the live order/session provider

# ICICI Breeze API Secrets (Never commit actual keys)
BREEZE_API_KEY=your_breeze_api_key_here
BREEZE_SECRET_KEY=your_breeze_secret_key_here
BREEZE_SESSION_TOKEN=your_daily_session_token_here

# Zerodha Kite Connect Secrets (used when BROKER_BACKEND=kite; never commit actual keys)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REQUEST_TOKEN=your_daily_request_token_here
KITE_ACCESS_TOKEN=                          # optional: already-exchanged daily access token
KITE_PRODUCT=NRML                            # MIS, NRML, or CNC

# Observability
LOG_LEVEL=INFO

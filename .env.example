# ==============================================================================
# ICICI Direct Options Trading Platform v2 Configuration Template
# ==============================================================================

# Application Environment & Service Identity
APP_ENV=development                       # development, testing, or production
SERVICE_NAME=trading-platform             # Name of the service/process
DATA_ROOT=./data
TRADING_CONFIG_PATH=./config/trading.json         # Canonical non-secret strategy/operator config

# Event Bus & Streaming Backbone
EVENT_BUS_BACKEND=memory                  # memory (dev/test) or redpanda (production)
REDPANDA_BROKERS=localhost:19092          # Required if EVENT_BUS_BACKEND=redpanda
REDIS_URL=redis://localhost:6379/0        # Optional live cache/locks

# Trading Authority & Release Controls (Fail-Closed)
DEFAULT_TRADING_MODE=PAPER                # Always PAPER (LIVE cannot be default)
LOCAL_SINGLE_USER_MODE=false              # Set true only with API_HOST=127.0.0.1 for local no-login controls
LIVE_TRADING_ENABLED=false                # Master server-side gate for live orders
LIVE_ALLOWED_ACCOUNTS=[]                  # JSON array of approved accounts e.g. ["ACC123"]
LIVE_MAX_ORDER_NOTIONAL=50000             # Independent final LIVE order notional ceiling
LIVE_MAX_OPEN_POSITIONS=1                  # Independent final LIVE open-position ceiling
LIVE_MARKET_DATA_MAX_AGE_SECONDS=5         # Max age for real NIFTY execution-feed quotes

# API Gateway & Boundary Security
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]  # Strict list of origins; no wildcards
AUTH_SIGNING_KEY=change_me_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15                  # Short-lived API access token lifetime
REFRESH_TOKEN_EXPIRE_DAYS=7                      # Refresh-token lifetime
WS_TICKET_EXPIRE_SECONDS=60                      # One-time websocket ticket lifetime
MAX_REQUEST_BODY_BYTES=1048576             # Maximum request payload size in bytes (1MB)
RATE_LIMIT_ENABLED=true                    # Enable API rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5              # Max login attempts per minute per IP
RATE_LIMIT_ORDERS_PER_MINUTE=30            # Max order/risk commands per minute per client
RATE_LIMIT_GENERAL_PER_MINUTE=120          # Max general queries per minute per client
IDEMPOTENCY_TTL_SECONDS=86400              # Command idempotency cache TTL in seconds (24h)
AUTO_MIGRATE_ON_STARTUP=true               # Run migrations on startup (true in dev/test, false for strict prod)
MIGRATION_BACKUP_DIR=./data/backups        # Directory for pre-migration safety backups

# Market Data Feed
# For the recommended LIVE Kite-first/Breeze-reference profile, copy
# .env.local-live.example to .env instead of enabling LIVE in this safe template.
MARKET_DATA_BACKEND=simulated             # simulated, breeze, kite, or hybrid
LIVE_EXECUTION_BROKER=breeze              # breeze or kite; owns the entire LIVE order lifecycle
FREQUENT_DATA_BROKER=kite                 # hybrid: high-frequency quotes/candles
REFERENCE_DATA_BROKER=breeze              # hybrid: option-chain/reference data
# BROKER_BACKEND is accepted as a legacy alias for LIVE_EXECUTION_BROKER

# ICICI Breeze API Secrets (Never commit actual keys)
BREEZE_API_KEY=your_breeze_api_key_here
BREEZE_SECRET_KEY=your_breeze_secret_key_here
BREEZE_SESSION_TOKEN=your_daily_session_token_here
BREEZE_CALLS_PER_MINUTE=90                      # Platform cap with headroom below broker limit
BREEZE_CALLS_PER_DAY=4800                        # Daily platform-side cap
BREEZE_WRITES_PER_SECOND=8                       # Write-side safety cap

# Research-only historical provider configuration
# Contract IDs remain explicit so a research run cannot silently cross an expiry.
RESEARCH_BREEZE_NIFTY_FUT_EXPIRY=               # YYYY-MM-DD, e.g. current NIFTY futures expiry
UPSTOX_ACCESS_TOKEN=                             # Optional research source: futures + India VIX
RESEARCH_UPSTOX_NIFTY_FUT_INSTRUMENT_KEY=        # Exact Upstox instrument_key for chosen NIFTY future
DHAN_ACCESS_TOKEN=                               # Optional research source: NIFTY futures
RESEARCH_DHAN_NIFTY_FUT_SECURITY_ID=             # Exact Dhan securityId for chosen NIFTY future

# Zerodha Kite Connect Secrets (execution and/or hybrid data routing)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REQUEST_TOKEN=your_daily_request_token_here
KITE_ACCESS_TOKEN=                          # optional: already-exchanged daily access token
KITE_PRODUCT=NRML                            # MIS, NRML, or CNC

# Observability
LOG_LEVEL=INFO

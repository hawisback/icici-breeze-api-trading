# ==============================================================================
# LIVE Trading Profile — Kite execution/frequent data + Breeze reference data
# ==============================================================================
#
# Copy this file to .env on the trading host, then replace every credential/token
# placeholder. The real .env is gitignored and must never be committed.
#
# Trading authority is intentionally split:
#   1) .env -> server may perform LIVE trading at all.
#   2) config/trading.json -> strategy mode (PAPER / SHADOW_ONLY / LIVE), enabled
#      strategies, risk limits, sessions and tunables.
#   3) Runtime ARM -> explicit operator action required after every restart.
#
# Important UI behavior:
#   - Selecting PAPER in the strategy UI persists mode=PAPER, disarms the system,
#     and all A-E strategies execute only through the paper path.
#   - Selecting LIVE only requests LIVE strategy mode. It does NOT arm the system.
#   - Restarting always returns the strategy system to DISARMED.
#
# Broker/data split used by this profile:
#   - Zerodha Kite: LIVE order lifecycle + frequent quotes/candles/history.
#   - ICICI Breeze: lower-frequency reference/option-chain/Greeks data.
#   - Both broker sessions can be active simultaneously.

# ------------------------------------------------------------------------------
# Application environment & filesystem
# ------------------------------------------------------------------------------
APP_ENV=development
SERVICE_NAME=trading-platform-live
DATA_ROOT=./data
TRADING_CONFIG_PATH=./config/trading.json

# ------------------------------------------------------------------------------
# Eventing/cache
# ------------------------------------------------------------------------------
# memory is supported for a local workstation profile. Use redpanda for a
# production deployment and configure REDPANDA_BROKERS accordingly.
EVENT_BUS_BACKEND=memory
REDPANDA_BROKERS=localhost:19092
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# LIVE trading authority & hard platform limits
# ------------------------------------------------------------------------------
# DEFAULT_TRADING_MODE is the safe generic/manual-order default and is required
# by validation to remain PAPER. Automated strategy mode comes from trading.json
# and may be switched PAPER/SHADOW_ONLY/LIVE in the UI.
DEFAULT_TRADING_MODE=PAPER

# Keep authentication enabled. If you deliberately want no-login local controls,
# set true only while API_HOST is loopback.
LOCAL_SINGLE_USER_MODE=false

# Master server capability gate. If false, no strategy can arm for LIVE.
LIVE_TRADING_ENABLED=true

# Logical account allowlist used by the broker gateway/preflight.
# Kite execution requires ZERODHA_PRIMARY. ICICI_PRIMARY remains allowed because
# Breeze is kept active for reference data and can be selected later if desired.
LIVE_ALLOWED_ACCOUNTS=["ZERODHA_PRIMARY","ICICI_PRIMARY"]

# Independent platform ceilings applied in addition to strategy risk controls.
LIVE_MAX_ORDER_NOTIONAL=50000
LIVE_MAX_OPEN_POSITIONS=1

# Maximum age of the execution-grade live quote used by LIVE safety/preflight.
LIVE_MARKET_DATA_MAX_AGE_SECONDS=5

# ------------------------------------------------------------------------------
# API/network/authentication
# ------------------------------------------------------------------------------
# Loopback binding is recommended for a local live-trading workstation.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MUST be replaced with a unique random secret of at least 32 bytes before use.
AUTH_SIGNING_KEY=replace-with-a-unique-random-signing-key-at-least-32-bytes-long

# Authentication/session lifetime.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
WS_TICKET_EXPIRE_SECONDS=60

# API boundary protection.
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_ORDERS_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=120
IDEMPOTENCY_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Database migration safety
# ------------------------------------------------------------------------------
AUTO_MIGRATE_ON_STARTUP=true
MIGRATION_BACKUP_DIR=./data/backups

# ------------------------------------------------------------------------------
# Broker ownership & market-data routing
# ------------------------------------------------------------------------------
# Kite owns the complete LIVE order lifecycle: submit/modify/cancel/reconcile.
LIVE_EXECUTION_BROKER=kite

# HYBRID activates both adapters and uses the two routing roles below.
MARKET_DATA_BACKEND=hybrid

# High-frequency operations: live quotes, candle refreshes, historical refreshes.
FREQUENT_DATA_BROKER=kite

# Lower-frequency/reference operations: option-chain/reference/Greeks data.
REFERENCE_DATA_BROKER=breeze

# ------------------------------------------------------------------------------
# Zerodha Kite Connect — LIVE execution + frequent data
# ------------------------------------------------------------------------------
KITE_API_KEY=replace_with_your_kite_api_key
KITE_API_SECRET=replace_with_your_kite_api_secret

# Daily authentication: provide either an already-exchanged access token OR the
# request token needed for startup exchange. Access tokens are daily credentials.
KITE_REQUEST_TOKEN=
KITE_ACCESS_TOKEN=

# Product passed to Kite order placement. Keep NRML unless you intentionally
# choose MIS/CNC and have validated the broker/product behavior for this system.
KITE_PRODUCT=NRML

# ------------------------------------------------------------------------------
# ICICI Breeze — lower-frequency reference/option-chain/Greeks data
# ------------------------------------------------------------------------------
BREEZE_API_KEY=replace_with_your_breeze_api_key
BREEZE_SECRET_KEY=replace_with_your_breeze_secret_key
BREEZE_SESSION_TOKEN=replace_with_your_daily_breeze_session_token

# Platform-side Breeze API headroom. Routing already keeps frequent traffic on
# Kite; these limits provide an additional cap for Breeze calls/writes.
BREEZE_CALLS_PER_MINUTE=90
BREEZE_CALLS_PER_DAY=4800
BREEZE_WRITES_PER_SECOND=8

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

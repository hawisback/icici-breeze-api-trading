# Local single-user LIVE-capable workstation profile.
# Copy to .env and replace broker credentials before starting the app.
# Strategy mode still starts PAPER/disarmed; the UI LIVE switch changes mode
# but never arms the strategy system.

APP_ENV=development
SERVICE_NAME=trading-platform-local
DATA_ROOT=./data
TRADING_CONFIG_PATH=./config/trading.json

EVENT_BUS_BACKEND=memory
REDPANDA_BROKERS=localhost:19092
REDIS_URL=redis://localhost:6379/0

DEFAULT_TRADING_MODE=PAPER
LOCAL_SINGLE_USER_MODE=true
LIVE_TRADING_ENABLED=true
LIVE_ALLOWED_ACCOUNTS=["ICICI_PRIMARY","ZERODHA_PRIMARY"]
LIVE_MAX_ORDER_NOTIONAL=50000
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MARKET_DATA_MAX_AGE_SECONDS=5

API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTH_SIGNING_KEY=local-single-user-signing-key-change-me-before-use-2026
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_ORDERS_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=120
IDEMPOTENCY_TTL_SECONDS=86400
AUTO_MIGRATE_ON_STARTUP=true
MIGRATION_BACKUP_DIR=./data/backups

# LIVE order ownership is fixed up front. Choose breeze OR kite.
LIVE_EXECUTION_BROKER=breeze

# Hybrid routing keeps frequent reads on Kite and reference/option-chain
# requests on Breeze, independent of the execution broker above.
MARKET_DATA_BACKEND=hybrid
FREQUENT_DATA_BROKER=kite
REFERENCE_DATA_BROKER=breeze

# Configure both brokers so both daily sessions can be active simultaneously.
# ICICI Breeze credentials.
BREEZE_API_KEY=replace_with_your_breeze_api_key
BREEZE_SECRET_KEY=replace_with_your_breeze_secret_key
BREEZE_SESSION_TOKEN=

# Zerodha Kite credentials.
KITE_API_KEY=replace_with_your_kite_api_key
KITE_API_SECRET=replace_with_your_kite_api_secret
KITE_REQUEST_TOKEN=
KITE_ACCESS_TOKEN=
KITE_PRODUCT=NRML

LOG_LEVEL=INFO

# ==============================================================================
# ICICI Direct Options Trading Platform v2 — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Explicitly preserve template configuration
!.env.example

# ------------------------------------------------------------------------------
# Trading State, SQLite Databases & Backups (Durable Runtime Truth)
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/**/*.db-journal
data/backups/
backups/

# Keep directory structure with .gitkeep
!data/**/.gitkeep

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Testing, Linting & Type Checking
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# Frontend & Node.js (Next.js Trading UI)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# General Logs & Observability Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
*.log.*

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs & Editor Metadata
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# Temporary, Scratch & Profiling Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
*.prof

